# ═══════════════════════════════════════════════════
# Diki-Diki — Backend .env.example
# Copier en .env et remplir toutes les valeurs
# ⚠️  Ne jamais committer le fichier .env !
# ═══════════════════════════════════════════════════

# Serveur
PORT=4000
NODE_ENV=development

# ─── Supabase ──────────────────────────────────────
SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Sécurité ──────────────────────────────────────
JWT_SECRET=MINIMUM_256_BITS_generez_avec_openssl_rand_hex_32
ENCRYPTION_KEY=VOTRE_CLE_AES256

# ─── CinetPay — Mobile Money ───────────────────────
# Compte sur https://cinetpay.com
CINETPAY_API_KEY=VOTRE_CLE_API
CINETPAY_SITE_ID=VOTRE_SITE_ID
CINETPAY_NOTIFY_URL=https://api.podiumarenachallenge.com/v1/payment/webhook

# ─── Africa's Talking — SMS ────────────────────────
# Compte sur https://africastalking.com
AT_API_KEY=VOTRE_CLE
AT_USERNAME=diki-diki
AT_SENDER=PAC

# ─── Upstash Redis ─────────────────────────────────
# Compte gratuit sur https://upstash.com
UPSTASH_REDIS_URL=rediss://VOTRE_ID.upstash.io:6379
UPSTASH_REDIS_TOKEN=VOTRE_TOKEN

# ─── Firebase FCM — Push notifications ─────────────
FIREBASE_PROJECT_ID=diki-diki
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@diki-diki.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nVOTRE_CLE\n-----END RSA PRIVATE KEY-----\n"

# ─── Sentry — Monitoring ───────────────────────────
SENTRY_DSN=https://VOTRE_KEY@XXXXXXX.ingest.sentry.io/XXXXXXX
